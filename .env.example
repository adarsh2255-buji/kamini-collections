# ==============================================================================
# KAMINI COLLECTIONS - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and fill in your actual credentials.
# NEVER commit .env.local or real secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE & AUTHENTICATION
# Find these in your Supabase project settings: Settings -> API -> Project URL & API Keys
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# The service role key is strictly server-side.
# NEVER expose it in client-side code, NEXT_PUBLIC_ variables, or client bundles.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# ------------------------------------------------------------------------------
# 2. RAZORPAY PAYMENT GATEWAY
# Find these in your Razorpay Dashboard: Settings -> API Keys & Webhooks
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# 3. STORE AND PUBLIC CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp phone number (with country code, digits only e.g. 919496812845 for +91 94968 12845)
NEXT_PUBLIC_WHATSAPP_NUMBER=919496812845
NEXT_PUBLIC_STORE_NAME="Kamini Collections"
NEXT_PUBLIC_CONTACT_EMAIL="care@kaminicollections.com"
